rules_version = '2';

// Same owner as firestore.rules. Change the UID here and nowhere else.
function ownerUid() { return 'U8SYctoCDlVkSrhNYO2c033lrcU2'; }

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null && request.auth.uid == ownerUid();
    }

    // Upload ceiling comes from Settings → Quote defaults (maxUploadMB), so it can be
    // changed without redeploying rules. 25 MB applies until that setting exists.
    // Reading Firestore here needs the "Firebase Rules Firestore Service Agent" role on
    // the Storage service account (one-time grant, see DEPLOY.md). Without it uploads fail.
    function maxBytes() {
      let path = /databases/(default)/documents/settings/quoteDefaults;
      let mb = firestore.exists(path) && firestore.get(path).data.get('maxUploadMB', 25) is number
        ? firestore.get(path).data.get('maxUploadMB', 25)
        : 25;
      return mb * 1024 * 1024;
    }

    match /files/{fileId}/{name} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && request.resource.size <= maxBytes();
    }

    match /business/{name} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
